{
  "name": "ora-ui",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "prettier": "prettier --write '**/*.{json,md,js,ts,jsx,tsx,yml,css}'",
    "version": "pnpm changeset version && pnpm install --lockfile-only",
    "release": "pnpm changeset publish",
    "prepare": "lefthook install",
    "sandcastle": "npx tsx --env-file=.sandcastle/.env .sandcastle/main.mts",
    "sandcastle:clean": "git worktree list --porcelain | grep -E 'worktree .+\\.sandcastle' | sed 's/worktree //' | xargs -I{} git worktree remove --force {} 2>/dev/null; git worktree prune; git branch | grep -E 'agent-|sandcastle/implementer/' | xargs git branch -D"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.5.8",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^20",
    "lefthook": "^1.7.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.16",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.0.0"
}
