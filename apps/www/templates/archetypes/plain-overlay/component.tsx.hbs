'use client';

import { Dialog as DialogPrimitive } from '@base-ui/react/dialog';
import { XIcon } from '@phosphor-icons/react';

import { cn } from '@/registry/lib/utils';
import { Button } from '@/registry/ui/button';

// TODO: wrap the Base UI primitive for {{name}} if it is not Dialog
function {{Name}}({ ...props }: DialogPrimitive.Root.Props) {
  return <DialogPrimitive.Root data-slot="{{name}}" {...props} />;
}

function {{Name}}Trigger({ ...props }: DialogPrimitive.Trigger.Props) {
  return <DialogPrimitive.Trigger data-slot="{{name}}-trigger" {...props} />;
}

function {{Name}}Portal({ ...props }: DialogPrimitive.Portal.Props) {
  return <DialogPrimitive.Portal data-slot="{{name}}-portal" {...props} />;
}

function {{Name}}Close({ ...props }: DialogPrimitive.Close.Props) {
  return <DialogPrimitive.Close data-slot="{{name}}-close" {...props} />;
}

function {{Name}}Overlay({ className, ...props }: DialogPrimitive.Backdrop.Props) {
  return (
    <DialogPrimitive.Backdrop
      data-slot="{{name}}-overlay"
      className={cn(
        'fixed inset-0 isolate z-50 bg-black/80 duration-100 data-open:animate-in data-open:fade-in-0 data-closed:animate-out data-closed:fade-out-0',
        className
      )}
      {...props}
    />
  );
}

function {{Name}}Content({
  className,
  children,
  showCloseButton = true,
  ...props
}: DialogPrimitive.Popup.Props & {
  showCloseButton?: boolean;
}) {
  return (
    <{{Name}}Portal>
      <{{Name}}Overlay />
      <DialogPrimitive.Popup
        data-slot="{{name}}-content"
        className={cn(
          'fixed top-1/2 left-1/2 z-50 grid w-full max-w-[calc(100%-2rem)] -translate-x-1/2 -translate-y-1/2 gap-6 overflow-hidden rounded-lg bg-background p-6 text-sm ring-1 ring-primary/15 duration-100 outline-none sm:max-w-md data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 data-closed:animate-out data-closed:fade-out-0 data-closed:zoom-out-95',
          className
        )}
        {...props}
      >
        {children}
        {showCloseButton && (
          <DialogPrimitive.Close
            data-slot="{{name}}-close"
            render={<Button variant="ghost" className="absolute top-4 right-4" size="icon-sm" />}
          >
            <XIcon />
            <span className="sr-only">Close</span>
          </DialogPrimitive.Close>
        )}
      </DialogPrimitive.Popup>
    </{{Name}}Portal>
  );
}

function {{Name}}Title({ className, ...props }: DialogPrimitive.Title.Props) {
  return (
    <DialogPrimitive.Title
      data-slot="{{name}}-title"
      className={cn('text-base leading-none font-medium', className)}
      {...props}
    />
  );
}

function {{Name}}Description({ className, ...props }: DialogPrimitive.Description.Props) {
  return (
    <DialogPrimitive.Description
      data-slot="{{name}}-description"
      className={cn('text-sm text-secondary', className)}
      {...props}
    />
  );
}

export {
  {{Name}},
  {{Name}}Close,
  {{Name}}Content,
  {{Name}}Description,
  {{Name}}Overlay,
  {{Name}}Portal,
  {{Name}}Title,
  {{Name}}Trigger,
};
