{
  "name": "www",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/gen-registry.cli.ts --watch & next dev",
    "build": "next build",
    "start": "next start",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:codegen": "playwright codegen",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:watch": "vitest",
    "lint": "eslint",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "scaffold": "plop --plopfile scripts/plopfile.mjs",
    "gen:registry": "tsx scripts/gen-registry.cli.ts",
    "gen:registry:check": "tsx scripts/gen-registry.cli.ts --check",
    "gen:manifest": "tsx scripts/gen-manifest.ts",
    "gen:manifest:check": "tsx scripts/gen-manifest.ts --check",
    "build:registry": "pnpm gen:manifest && shadcn build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@heroicons/react": "^2.2.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.6.13",
    "fumadocs-mdx": "^14.2.9",
    "fumadocs-ui": "^16.6.13",
    "motion": "^12.40.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
